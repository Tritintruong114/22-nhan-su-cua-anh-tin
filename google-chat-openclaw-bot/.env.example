PORT=8080

# In production, keep this true. Set false only for local curl testing.
VERIFY_GOOGLE_CHAT=true

# Must exactly match the endpoint configured in Google Chat app settings.
GOOGLE_CHAT_AUDIENCE=https://YOUR_CLOUD_RUN_URL/google-chat

# Generic OpenClaw bridge endpoint. Configure this to the HTTP endpoint that can
# invoke OpenClaw sessions_send, or to a small local bridge you control.
OPENCLAW_SESSION_SEND_URL=https://YOUR_OPENCLAW_BRIDGE/sessions/send
OPENCLAW_TOKEN=replace-me
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSION_LABEL=google-chat
OPENCLAW_TIMEOUT_SECONDS=25
